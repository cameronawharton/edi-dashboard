rules_version = '2';
// Prevention Services Insight, demo phase (Nov 2026).
//
// Read:  anyone with the link can read the app's records (Cameron's decision for the leadership demo).
//        When county IT takes over, change `openRead()` to `workEmail()` and nothing else moves.
// Write: the owner (signed in with a verified @fmo.hctx.net address listed below) can change everything,
//        including loading the data bundle. A supervisor or command staff member may link themselves only to the
//        team profile whose email on file (emailLc) is their own signed-in address, and send feedback. Inspectors have no account.
service cloud.firestore {
  match /databases/{database}/documents {

    function openRead() { return true; }
    function signedIn() { return request.auth != null; }
    function workEmail() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@fmo[.]hctx[.]net$');
    }
    function isOwner() { return workEmail() && request.auth.token.email.lower() in ['cameron.wharton@fmo.hctx.net']; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Nov 10 2026: a supervisory and management tool. Only these roles link a profile or send feedback.
    function leaderRole(r) { return r in ['chief', 'captain', 'lieutenant', 'sergeant', 'manager']; }

    match /{col}/{id} {
      allow read: if openRead() && col in ['orgs', 'ledgers', 'projects', 'team', 'er', 'actions', 'flags', 'stats',
                                           'log', 'cfac', 'windows', 'config', 'inbox'];
      allow write: if isOwner();
    }

    // Profile linking: a supervisor or command staff member can link (or unlink) ONLY the profile whose emailLc is their own signed-in address.
    match /team/{id} {
      allow update: if workEmail()
        && leaderRole(resource.data.get('role', ''))
        && resource.data.get('emailLc', '') == request.auth.token.email.lower()
        && changed().hasOnly(['userId', 'accountName', 'linkedAt', 'updatedAt'])
        && resource.data.get('userId', null) in [null, request.auth.uid]
        && request.resource.data.get('userId', null) in [null, request.auth.uid];
    }

    // Feedback page: a linked supervisor or command staff member sends; only the owner reads everything; authors can read their own.
    match /feedback/{id} {
      allow create: if workEmail() && request.resource.data.uid == request.auth.uid
        && request.resource.data.member is string
        && get(/databases/$(database)/documents/team/$(request.resource.data.member)).data.get('userId', null) == request.auth.uid
        && leaderRole(get(/databases/$(database)/documents/team/$(request.resource.data.member)).data.get('role', ''))
        && request.resource.data.keys().hasOnly(['type', 'page', 'text', 'uid', 'email', 'name', 'member', 'at', 'status'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 3000
        && request.resource.data.status == 'new';
      allow read: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isOwner();
    }

    // per-person private data (pinned districts and schools)
    match /data/users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
