rules_version = '2';
// CO/ED Division Insight, demo phase (Nov 2026).
//
// Read:  anyone with the link can read the app's records (Cameron's decision for the leadership demo).
//        When county IT takes over, change `openRead()` to `workEmail()` and nothing else moves.
// Write: the owner (signed in with a verified @fmo.hctx.net address listed below) can change everything,
//        including loading the data bundle. Anyone signed in with a county address may link themselves to
//        their own team profile ("This is me"), and nothing else.
service cloud.firestore {
  match /databases/{database}/documents {

    function openRead() { return true; }
    function signedIn() { return request.auth != null; }
    function workEmail() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@fmo[.]hctx[.]net$');
    }
    function isOwner() { return workEmail() && request.auth.token.email.lower() in ['cameron.wharton@fmo.hctx.net']; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /{col}/{id} {
      allow read: if openRead() && col in ['orgs', 'ledgers', 'projects', 'team', 'er', 'actions', 'flags', 'stats',
                                           'log', 'cfac', 'windows', 'config', 'inbox'];
      allow write: if isOwner();
    }

    // "This is me": a county user links their own profile once.
    match /team/{id} {
      allow update: if workEmail()
        && changed().hasOnly(['userId', 'accountName', 'linkedAt', 'updatedAt'])
        && resource.data.get('userId', null) in [null, request.auth.uid]
        && request.resource.data.userId == request.auth.uid;
    }

    // per-person private data (pinned districts and schools)
    match /data/users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
